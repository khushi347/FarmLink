# ==============================================================================
# FarmLink Backend — Production & Development Environment Configuration Template
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/farmlink or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/farmlink

# JWT Authentication Secrets (Generate secure >= 32-character random strings for production)
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long

# Allowed Frontend Origins for CORS and WebSocket connections (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Google Gemini API Key for Multilingual Agricultural Voice/Text Order Parsing
GEMINI_API_KEY=your_google_gemini_api_key

# Optional: Sarvam AI Key for Indian Dialect Speech-to-Text
SARVAM_API_KEY=your_sarvam_api_key

# Twilio WhatsApp Webhook Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_WEBHOOK_PUBLIC_URL=https://your-domain.com/api/webhooks/whatsapp

# Rate Limiting Controls
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
